{
  "name": "moodtrack",
  "version": "1.0.0",
  "description": "Privacy-first Daily Mood & Stress Tracking platform for colleges",
  "main": "server/src/index.js",
  "scripts": {
    "server": "node server/src/index.js",
    "seed": "node server/src/seed.js",
    "test:stress": "node server/src/testStressEngine.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
